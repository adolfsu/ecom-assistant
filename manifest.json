{
  "manifest_version": 3,
  "name": "电商小助手",
  "version": "2.1.0",
  "description": "抖店经营提效工具集：批量填充 SKU、批量发布相似品、批量复制变体。2.0 采用弹窗快速入口 + 侧边栏工作台。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.jinritemai.com/*",
    "https://*.douyin.com/*"
  ],
  "action": {
    "default_popup": "app/popup/index.html",
    "default_title": "电商小助手"
  },
  "side_panel": {
    "default_path": "app/sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jinritemai.com/*",
        "https://*.douyin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.jinritemai.com/*",
        "https://*.douyin.com/*"
      ],
      "js": [
        "similar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
